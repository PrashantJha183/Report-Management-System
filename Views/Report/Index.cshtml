@model Report.Models.ReportGridViewModel

@{
    ViewBag.Title = "Reports";
}

<head>
    <link rel="stylesheet" href="~/Styles/ReportMaster.css" />
</head>


<div class="container-fluid" style="margin-top:20px;">
    <div id="toast" style="display:none; position:fixed; top:80px; right:20px; z-index:9999; padding:12px 20px; border-radius:4px; color:#fff; font-weight:bold; box-shadow:0 4px 8px rgba(0,0,0,0.2);"></div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Confirm Delete</h4>
                </div>
                <div class="modal-body">
                    <p id="deleteConfirmMessage">Are you sure you want to delete this record?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmOk">Delete</button>
                </div>
            </div>
        </div>
    </div>

<div class="modal fade" id="saveConfirmModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">X</button>
                <h4 class="modal-title">Confirm Save</h4>
            </div>
            <div class="modal-body">
                <p id="saveConfirmMessage">Are you sure you want to save this row?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveConfirmOk">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="successModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">X</button>
                <h4 class="modal-title">Success</h4>
            </div>
            <div class="modal-body">
                <p id="successModalMessage">Row saved successfully.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
    </div>

    <h3><a href="#" onclick="history.back(); return false;" style="text-decoration:none; color:inherit;">&larr;</a> Report Master</h3>
    <p class="text-muted">Total Records: @Model.TotalRecords</p>

    <div class="report-toolbar">
        @using (Html.BeginForm("Index", "Report", FormMethod.Get, new { @class = "page-size-form toolbar-form" }))
        {
            <div class="sort-direction-box">
                @Html.DropDownListFor(
                    x => x.SortDirection,
                    new SelectList(
                        new[]
                        {
                            new { Value = "asc", Text = "Ascending" },
                            new { Value = "desc", Text = "Descending" }
                        },
                        "Value",
                        "Text",
                        Model.SortDirection),
                    new { @class = "form-control page-size-select", onchange = "this.form.submit()" })
            </div>

            <div class="filter-linkitem-box" style="width:200px; flex:0 0 200px; position:relative;">
                <input type="hidden" name="FilterLinkItemId" id="FilterLinkItemId" value="@Model.FilterLinkItemId">
                <input type="text" id="FilterLinkItemText" class="form-control page-size-select" placeholder="-- All Link Items --" autocomplete="off">
                <ul id="filterAutocompleteList" style="display:none;" class="autocomplete-suggestions"></ul>
            </div>

            <input type="hidden" name="SortColumn" value="ReportId" />
            <input type="hidden" name="PageSize" value="5" />
        }
        <button type="button" id="btnDeletedRecords" class="btn modern-btn" style="margin-left:10px; background:#6b21a8 !important; border-color:#6b21a8 !important; color:#fff !important; font-weight:700;">Deleted Records</button>
        <button type="button" id="btnAddRow" class="btn modern-btn modern-btn-primary" style="margin-left:auto;">Add Row</button>
    </div>

    <div class="table-panel-container">
        <div class="table-wrapper" id="tableWrapper">
            <div class="modern-table-shell">
                <table class="table modern-report-table">
                    <thead>
                        <tr>
                            <th style="width:8%">Report Id</th>
                            <th style="width:27%">Link Item Name</th>
                            <th style="width:35%">Query</th>
                            <th style="width:40%">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = 0;
                            foreach (var item in Model.Items)
                            {
                                rowIndex++;
                                var srNo = ((Model.PageNumber - 1) * Model.PageSize) + rowIndex;
                                <tr id="reportmaster-@srNo" data-table="@ViewBag.TableName" data-reportid="@item.ReportId"
                                    data-referencelinkid="@item.ReferenceLinkId"
                                    data-code="@item.Code"
                                    data-query="@item.Query"
                                    data-whereclause="@item.WhereClause"
                                    data-orderby="@item.OrderBy"
                                    data-detailquery="@item.DetailQuery"
                                    data-detailprimarykey="@item.DetailPrimaryKey"
                            data-ismasterdetail="@(item.IsMasterDetail ? "1" : "0")"
                            data-isstoreprocedure="@(item.IsStoreProcedure ? "1" : "0")"
                            data-reporttypeid="@item.ReportTypeId.ToString()"
                            data-islocationfilter="@(item.IsLocationFilter ? "1" : "0")">
                                    <td class="grid-text">@item.ReportId</td>
                                    <td class="grid-text" title="@item.ReferenceLinkName">@item.ReferenceLinkName</td>
                                    <td class="grid-text" title="@item.Query">@item.Query</td>
                                    <td class="action-cell">
                                        <button type="button" class="btn btn-xs btn-info btn-details"
                                                onclick="window.location='@Url.Action("Index", "ReportColumn", new { FilterReportId = item.ReportId, FilterCode = item.Code, FilterReportTypeId = item.ReportTypeId, FilterLinkItemName = item.ReferenceLinkName })'" style="margin-right:3px;">
                                            Report Column
                                        </button>
                                        <button type="button" class="btn btn-xs btn-filter-details"
                                                onclick="window.location='@Url.Action("Index", "ReportFilteringColumn", new { FilterReportId = item.ReportId, FilterLinkItemName = item.ReferenceLinkName })'" style="margin-right:3px;">
                                            Report Filtering Column
                                        </button>
                                        <button type="button" class="btn btn-xs btn-danger btn-delete" style="margin-left:3px;">Delete</button>
                                        <button type="button" class="btn btn-xs btn-info btn-view-audit" data-table="@ViewBag.AuditTableName" data-id="@item.ReportId" data-linkitemname="@item.ReferenceLinkName" style="margin-left:3px;">View</button>
                                        <button type="button" class="btn btn-xs btn-primary btn-edit" style="margin-left:3px;">Edit</button>
                                    </td>
                                </tr>
                                <tr class="edit-row" style="display:none" data-editfor="@srNo">
                                    <td colspan="4">
                                        <div class="edit-form">
                                            <div class="edit-form-row">
                                                    <div class="ef-field">
                                                        <label>Link Item Name<span class="required">*</span></label>
                                                        <input type="text" class="form-control autocomplete-link" data-column="ReferenceLinkId" autocomplete="off">
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Code</label>
                                                        <input type="text" class="form-control" data-column="Code">
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Report Type</label>
                                                        <select class="form-control" data-column="ReportTypeId">
                                                            <option value="1">1</option>
                                                            <option value="0">0</option>
                                                        </select>
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Location Filter</label>
                                                        <select class="form-control" data-column="IsLocationFilter">
                                                            <option value="1">1</option>
                                                            <option value="0" selected>0</option>
                                                        </select>
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Master Detail</label>
                                                        <select class="form-control" data-column="IsMasterDetail">
                                                            <option value="1">1</option>
                                                            <option value="0" selected>0</option>
                                                        </select>
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Is Store Procedure<span class="required">*</span></label>
                                                        <select class="form-control" data-column="IsStoreProcedure">
                                                            <option value="1">1</option>
                                                            <option value="0" selected>0</option>
                                                        </select>
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Order By</label>
                                                        <input type="text" class="form-control" data-column="OrderBy">
                                                    </div>
                                                    <div class="ef-field">
                                                        <label>Detail Primary Key</label>
                                                        <input type="text" class="form-control" data-column="DetailPrimaryKey">
                                                    </div>
                                                    <div class="ef-field full">
                                                        <div class="ef-row-center">
                                                            <div class="ef-field" style="flex:2;"><label>Query<span class="required">*</span></label><textarea class="form-control" data-column="Query" rows="2"></textarea></div>
                                                            <div class="ef-field" style="flex:1;"><label>Where Clause</label><textarea class="form-control" data-column="WhereClause" rows="2"></textarea></div>
                                                            <div class="ef-field" style="flex:1;"><label>Detail Query</label><textarea class="form-control" data-column="DetailQuery" rows="2"></textarea></div>
                                                        </div>
                                                    </div>
                                            </div>
                                            <div class="edit-form-actions">
                                                <button type="button" class="btn btn-save-form">Save</button>
                                                <button type="button" class="btn btn-cancel-form">Cancel</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="bottom-bar">
                <nav>
                    <ul class="pagination pagination-sm" style="display:flex; flex-wrap:nowrap; overflow-x:auto; margin:0;">
                        <li class="@(Model.HasPreviousPage ? "" : "disabled")">
                            @if (Model.HasPreviousPage)
                            {
                                <a href="@Url.Action("Index", new {
                                    SearchText = Model.SearchText,
                                    PageSize = Model.PageSize,
                                    SortColumn = Model.SortColumn,
                                    SortDirection = Model.SortDirection,
                                    PageNumber = Model.PageNumber - 1,
                                    FilterLinkItemId = Model.FilterLinkItemId
                                })">Previous</a>
                            }
                            else
                            {
                                <span>Previous</span>
                            }
                        </li>

                        @{
                            var windowSize = 5;
                            var halfWindow = windowSize / 2;
                            var startPage = Math.Max(1, Model.PageNumber - halfWindow);
                            var endPage = Math.Min(Model.TotalPages, startPage + windowSize - 1);
                            startPage = Math.Max(1, endPage - windowSize + 1);
                        }

                        @if (startPage > 1)
                        {
                            <li>
                                <a href="@Url.Action("Index", new {
                                    SearchText = Model.SearchText,
                                    PageSize = Model.PageSize,
                                    SortColumn = Model.SortColumn,
                                    SortDirection = Model.SortDirection,
                                    PageNumber = 1,
                                    FilterLinkItemId = Model.FilterLinkItemId
                                })">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="disabled"><a href="#">...</a></li>
                            }
                        }

                        @for (var page = startPage; page <= endPage; page++)
                        {
                            <li class="@(page == Model.PageNumber ? "active" : "")">
                                <a href="@Url.Action("Index", new {
                                    SearchText = Model.SearchText,
                                    PageSize = Model.PageSize,
                                    SortColumn = Model.SortColumn,
                                    SortDirection = Model.SortDirection,
                                    PageNumber = page,
                                    FilterLinkItemId = Model.FilterLinkItemId
                                })">@page</a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="disabled"><a href="#">...</a></li>
                            }
                            <li>
                                <a href="@Url.Action("Index", new {
                                    SearchText = Model.SearchText,
                                    PageSize = Model.PageSize,
                                    SortColumn = Model.SortColumn,
                                    SortDirection = Model.SortDirection,
                                    PageNumber = Model.TotalPages,
                                    FilterLinkItemId = Model.FilterLinkItemId
                                })">@Model.TotalPages</a>
                            </li>
                        }

                        <li class="@(Model.HasNextPage ? "" : "disabled")">
                            @if (Model.HasNextPage)
                            {
                                <a href="@Url.Action("Index", new {
                                    SearchText = Model.SearchText,
                                    PageSize = Model.PageSize,
                                    SortColumn = Model.SortColumn,
                                    SortDirection = Model.SortDirection,
                                    PageNumber = Model.PageNumber + 1,
                                    FilterLinkItemId = Model.FilterLinkItemId
                                })">Next</a>
                            }
                            else
                            {
                                <span>Next</span>
                            }
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="modal fade" id="auditModal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title" id="auditPanelTitle">Change History</h4>
                    </div>
                    <div class="modal-body">
                        <div id="auditLoading" style="text-align:center; padding:20px;">Loading...</div>
                        <div id="auditContent" style="display:none;">
                            <table class="table table-bordered table-striped" style="font-size:12px;">
                                <thead>
                                    <tr>
                                        <th style="width:40px">#</th>
                                        <th style="width:160px">Date &amp; Time</th>
                                        <th style="width:80px">Action</th>
                                        <th>Old Value (JSON)</th>
                                    </tr>
                                </thead>
                                <tbody id="auditBody"></tbody>
                            </table>
                        </div>
                        <div id="auditEmpty" style="display:none; text-align:center; padding:20px; color:#888;">No change history found.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="auditPanel" style="display:none; flex:0 0 calc(50% - 15px); min-width:280px; border:1px solid #ddd; border-radius:6px; background:#fff; margin-left:15px; align-self:stretch;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f5f5f5; border-bottom:1px solid #ddd;">
                <strong style="font-size:14px; color:#1a1a2e;">Change History</strong>
                <button type="button" id="btnCloseAudit" style="border:none; background:none; font-size:22px; cursor:pointer; line-height:1; color:#666; padding:0 4px;">&times;</button>
            </div>
            <iframe id="auditIframe" style="width:100%; height:calc(100vh - 250px); border:none; display:block;"></iframe>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var linkItems = @Html.Raw(Json.Encode(ViewBag.LinkItems));
        var displayIdCounter = @(ViewBag.NextIdentity ?? 1);
        var saveChangesUrl = '@Url.Action("SaveChanges", "Report")';
        var reportColumnUrl = '@Url.Action("Index", "ReportColumn")';
        var reportFilteringColumnUrl = '@Url.Action("Index", "ReportFilteringColumn")';
        var deleteUrl = '@Url.Action("Delete", "Report")';
        var auditUrl = '@Url.Action("GetAuditLogs", "AuditTrail")';
        var auditViewUrl = '@Url.Action("AuditLogs", "AuditTrail")';
        var deletedRecordsUrl = '@Url.Action("DeletedRecords", "AuditTrail")';
        var tableName = '@ViewBag.TableName';
        var auditTableName = '@ViewBag.AuditTableName';
        var recordIdLabel = '@ViewBag.RecordIdLabel';
        var colspan = @ViewBag.Colspan;
    </script>
    <script src="~/js/ReportMaster.js"></script>
}
