@model Report.Models.DynamicCodeGridViewModel

@{
    ViewBag.Title = "Dynamic Code";
    var defaultNamespaces = System.Configuration.ConfigurationManager.AppSettings["DefaultNamespaces"] ?? "";
    var jsDefaultNamespaces = (defaultNamespaces ?? "").Replace("\\", "\\\\").Replace("'", "\\'");
}

<head>
    <link rel="stylesheet" href="~/Styles/DynamicCode.css" />
</head>

<div class="container-fluid" style="margin-top:20px;">
    @* OLD toast element (kept for reference). Global #toast is rendered once in _Layout.cshtml *@
    <div id="toast" style="display:none; position:fixed; top:80px; right:20px; z-index:9999; padding:12px 20px; border-radius:4px; color:#fff; font-weight:bold; box-shadow:0 4px 8px rgba(0,0,0,0.2);"></div>

    <!-- ── Delete Confirm Modal ── -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Confirm Delete</h4>
                </div>
                <div class="modal-body">
                    <p id="deleteConfirmMessage">Are you sure you want to delete this record?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmOk">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Success Modal ── -->
    <div class="modal fade" id="successModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Success</h4>
                </div>
                <div class="modal-body">
                    <p id="successModalMessage">Row saved successfully.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ══  GRID SECTION  ══                           -->
    <!-- ═══════════════════════════════════════════════ -->
    <div id="gridSection">
        <h3><a href="#" onclick="history.back(); return false;" style="text-decoration:none; color:inherit;">←</a> Dynamic Code</h3>
        <p class="text-muted">Total Records: @Model.TotalRecords</p>

        <div class="report-toolbar">
            @using (Html.BeginForm("Index", "DynamicCode", FormMethod.Get, new { @class = "page-size-form toolbar-form" }))
            {
                <div class="sort-direction-box">
                    @Html.DropDownListFor(
                             x => x.SortDirection,
                             new SelectList(
                                 new[]
                                 {
                                new { Value = "asc", Text = "Ascending" },
                                new { Value = "desc", Text = "Descending" }
                                 },
                                 "Value",
                                 "Text",
                                 Model.SortDirection),
                             new { @class = "form-control page-size-select", onchange = "this.form.submit()" })
                </div>

                <div class="search-box" style="position:relative;">
                    <input type="text" name="SearchText" value="@Model.SearchText" class="form-control page-size-select" placeholder="Search..." style="width:200px;" />
                </div>

                <input type="hidden" name="SortColumn" value="@Model.SortColumn" />
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
            }
            <div style="display:flex; gap:8px; margin-left:auto;">
                <button type="button" id="btnDeletedRecords" class="btn modern-btn" style="background:#6b21a8 !important; border-color:#6b21a8 !important; color:#fff !important; font-weight:700;">Deleted Records</button>
                <button type="button" id="btnAddRow" class="btn modern-btn modern-btn-primary">Add Row</button>
            </div>
        </div>

        <div class="table-panel-container">
            <div class="table-wrapper" id="tableWrapper">
                <div class="modern-table-shell">
                    <table class="table modern-report-table">
                        <thead>
                            <tr>
                                <th style="width:8%">Code ID</th>
                                <th style="width:20%">Controller Name</th>
                                <th style="width:20%">Action Name</th>
                                <th style="width:32%">Description</th>
                                <th style="width:20%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items == null || !Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        No records found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                var rowIndex = 0;
                                foreach (var item in Model.Items)
                                {
                                    rowIndex++;
                                    var srNo = ((Model.PageNumber - 1) * Model.PageSize) + rowIndex;
                                    <tr id="dynamiccode-@srNo" data-table="@ViewBag.TableName" data-dynamiccodeid="@item.DynamicCodeId"
                                        data-controllername="@item.ControllerName"
                                        data-actionname="@item.ActionName"
                                        data-description="@item.Description">
                                        <td class="grid-text">@item.DynamicCodeId</td>
                                        <td class="grid-text" title="@item.ControllerName">@item.ControllerName</td>
                                        <td class="grid-text" title="@item.ActionName">@item.ActionName</td>
                                        <td class="grid-text" title="@item.Description">@item.Description</td>
                                        <td class="action-cell">
                                            <button type="button" class="btn btn-xs btn-primary btn-edit">Edit</button>
                                            <button type="button" class="btn btn-xs btn-info btn-view-audit" data-table="@ViewBag.AuditTableName" data-id="@item.DynamicCodeId" style="margin-left:3px;">View</button>
                                            @if (Session["Role"]?.ToString() == "SuperAdmin")
                                            {
                                                <button type="button" class="btn btn-xs btn-danger btn-delete" style="margin-left:3px;">Delete</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bottom-bar">
                    <nav>
                        <ul class="pagination pagination-sm" style="display:flex; flex-wrap:nowrap; overflow-x:auto; margin:0;">
                            <li class="@(Model.HasPreviousPage ? "" : "disabled")">
                                @if (Model.HasPreviousPage)
                                {
                                    <a href="@Url.Action("Index", new {
                                        SearchText = Model.SearchText,
                                        PageSize = Model.PageSize,
                                        SortColumn = Model.SortColumn,
                                        SortDirection = Model.SortDirection,
                                        PageNumber = Model.PageNumber - 1
                                    })">Previous</a>
                                }
                                else
                                {
                                    <span>Previous</span>
                                }
                            </li>

                            @{
                                var windowSize = 5;
                                var halfWindow = windowSize / 2;
                                var startPage = Math.Max(1, Model.PageNumber - halfWindow);
                                var endPage = Math.Min(Model.TotalPages, startPage + windowSize - 1);
                                startPage = Math.Max(1, endPage - windowSize + 1);
                            }

                            @if (startPage > 1)
                            {
                                <li>
                                    <a href="@Url.Action("Index", new {
                                        SearchText = Model.SearchText,
                                        PageSize = Model.PageSize,
                                        SortColumn = Model.SortColumn,
                                        SortDirection = Model.SortDirection,
                                        PageNumber = 1
                                    })">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="disabled"><a href="#">...</a></li>
                                }
                            }

                            @for (var page = startPage; page <= endPage; page++)
                            {
                                <li class="@(page == Model.PageNumber ? "active" : "")">
                                    <a href="@Url.Action("Index", new {
                                        SearchText = Model.SearchText,
                                        PageSize = Model.PageSize,
                                        SortColumn = Model.SortColumn,
                                        SortDirection = Model.SortDirection,
                                        PageNumber = page
                                    })">@page</a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="disabled"><a href="#">...</a></li>
                                }
                                <li>
                                    <a href="@Url.Action("Index", new {
                                        SearchText = Model.SearchText,
                                        PageSize = Model.PageSize,
                                        SortColumn = Model.SortColumn,
                                        SortDirection = Model.SortDirection,
                                        PageNumber = Model.TotalPages
                                    })">@Model.TotalPages</a>
                                </li>
                            }

                            <li class="@(Model.HasNextPage ? "" : "disabled")">
                                @if (Model.HasNextPage)
                                {
                                    <a href="@Url.Action("Index", new {
                                        SearchText = Model.SearchText,
                                        PageSize = Model.PageSize,
                                        SortColumn = Model.SortColumn,
                                        SortDirection = Model.SortDirection,
                                        PageNumber = Model.PageNumber + 1
                                    })">Next</a>
                                }
                                else
                                {
                                    <span>Next</span>
                                }
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>

            <div id="auditPanel" style="display:none; flex:0 0 calc(50% - 15px); min-width:280px; border:1px solid #ddd; border-radius:6px; background:#fff; margin-left:15px; align-self:stretch;">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f5f5f5; border-bottom:1px solid #ddd;">
                    <strong id="auditPanelTitle" style="font-size:14px; color:#1a1a2e;">Change History</strong>
                    <button type="button" id="btnCloseAudit" style="border:none; background:none; font-size:22px; cursor:pointer; line-height:1; color:#666; padding:0 4px;">&times;</button>
                </div>
                <iframe id="auditIframe" style="width:100%; height:calc(100vh - 250px); border:none; display:block;"></iframe>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- ══  IDE SECTION  ══                           -->
    <!-- ═══════════════════════════════════════════════ -->
    <div id="ideSection" style="display:none;">
        <div class="ide-panel">
            <div class="ide-panel-header">
                <a href="#" id="ideBackToGrid" style="color:#0f766e; text-decoration:none; font-weight:600; font-size:14px;">← Back to Listing</a>
                <h3 style="margin:0; color:#333; flex:1;">Dynamic Code Editor</h3>
            </div>

            <div class="ide-panel-fields">
                <div class="ef-field">
                    <label>Controller Name</label>
                    <input type="text" id="ideControllerName" class="form-control" placeholder="Controller Name" />
                </div>
                <div class="ef-field">
                    <label>Action Name</label>
                    <input type="text" id="ideActionName" class="form-control" placeholder="Action Name" />
                </div>
                <div class="ef-field">
                    <label>Description</label>
                    <input type="text" id="ideDescription" class="form-control" placeholder="Description" />
                </div>
            </div>

            <div class="ide-panel-body">
                <div class="ide-panel-namespaces">
                    <label>Namespaces</label>
                    @Html.Action("NamespaceEditor", "NameSpace", new
                    {
                        textareaId = "txtNamespaces",
                        value = defaultNamespaces
                    })
                </div>
                <div class="ide-panel-editor">
                    <label>Code</label>
                    @Html.Action("CodeEditor", "Intellisense", new
                    {
                        editorId = "editorContainer",
                        hiddenFieldId = "hdnCode",
                        code = ""
                    })
                </div>
            </div>

            <div class="ide-panel-footer">
                <button type="button" id="ideSave" class="btn modern-btn" style="background:#0f766e; color:#fff;">Save</button>
                <button type="button" id="ideCancel" class="btn modern-btn" style="background:#e5e7eb; color:#374151;">Cancel</button>
                <span id="ideStatus" style="font-size:13px; font-weight:600;"></span>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script>
        var displayIdCounter = @(ViewBag.NextIdentity ?? 1);
        var saveChangesUrl = '@Url.Action("SaveChanges", "DynamicCode")';
        var deleteUrl = '@Url.Action("Delete", "DynamicCode")';
        var getCodeUrl = '@Url.Action("GetCode", "DynamicCode")';
        var saveCodeUrl = '@Url.Action("SaveCode", "DynamicCode")';
        var loadClassesUrl = '@Url.Action("LoadClassesFromNamespaces", "DynamicCode")';
        var auditViewUrl = '@Url.Action("AuditLogs", "AuditTrail")';
        var deletedRecordsUrl = '@Url.Action("DeletedRecords", "AuditTrail")';
        var defaultNamespaces = '@Html.Raw(jsDefaultNamespaces)';
        var currentUserRole = '@Session["Role"]';
        var tableName = '@ViewBag.TableName';
        var auditTableName = '@ViewBag.AuditTableName';
        var recordIdLabel = '@ViewBag.RecordIdLabel';
        var colspan = @ViewBag.Colspan;

        $(document).on('click', '.btn-view-audit', function () {
            var $wrapper = $('#tableWrapper');
            var $panel = $('#auditPanel');
            var recordId = $(this).data('id');
            var viewTable = $(this).data('table');
            var src = (window.auditViewUrl || '/AuditTrail/AuditLogs') + '?tableName=' + encodeURIComponent(viewTable) + '&recordId=' + encodeURIComponent(recordId) + '&recordIdLabel=' + encodeURIComponent(window.recordIdLabel || 'Code ID');
            $('#auditPanelTitle').text('Change History');
            $('#auditIframe').attr('src', src);
            $wrapper.css('flex', '1 1 50%');
            $panel.show();
        });

        $('#btnDeletedRecords').on('click', function () {
            var $wrapper = $('#tableWrapper');
            var $panel = $('#auditPanel');
            var src = (window.deletedRecordsUrl || '/AuditTrail/DeletedRecords') + '?tableName=' + encodeURIComponent(window.auditTableName || window.tableName);
            $('#auditPanelTitle').text('Deleted Records');
            $('#auditIframe').attr('src', src);
            $wrapper.css('flex', '1 1 50%');
            $panel.show();
        });

        $('#btnCloseAudit').on('click', function () {
            $('#tableWrapper').css('flex', '1 1 100%');
            $('#auditPanel').hide();
            $('#auditIframe').attr('src', '');
        });
    </script>
    <script src="~/js/DynamicCode.js"></script>
}
