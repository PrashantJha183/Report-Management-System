@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Manrope", "Inter", sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f766e 100%);
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: rgba(15, 118, 110, 0.15);
            top: -200px;
            right: -200px;
        }

        body::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(15, 118, 110, 0.1);
            bottom: -100px;
            left: -100px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
            padding: 48px 40px 40px;
            width: 420px;
            position: relative;
            z-index: 1;
            backdrop-filter: blur(20px);
        }

        .login-card .avatar {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #0f766e, #115e59);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .login-card .avatar svg {
            width: 32px;
            height: 32px;
            fill: #fff;
        }

        .login-card h2 {
            font-weight: 800;
            font-size: 22px;
            color: #0f172a;
            text-align: center;
            margin-bottom: 6px;
        }

        .login-card .subtitle {
            text-align: center;
            color: #64748b;
            font-size: 14px;
            margin-bottom: 28px;
        }

        .login-card .form-label {
            font-weight: 600;
            font-size: 13px;
            color: #334155;
            margin-bottom: 4px;
        }

        .login-card .input-group {
            position: relative;
        }

        .login-card .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 11px 16px;
            font-size: 14px;
            color: #0f172a;
            background: #f8fafc;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            height: auto;
        }

        .login-card .form-control:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
            background: #fff;
        }

        .login-card .password-wrapper {
            position: relative;
        }

        .login-card .password-wrapper .form-control {
            padding-right: 44px;
        }

        .login-card .toggle-pw {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: #94a3b8;
            line-height: 0;
            transition: color 0.2s;
        }

        .login-card .toggle-pw:hover {
            color: #0f766e;
        }

        .login-card .toggle-pw svg {
            width: 20px;
            height: 20px;
        }

        .login-card .btn-primary {
            background: #0f766e;
            border: none;
            font-weight: 700;
            font-size: 15px;
            padding: 12px;
            width: 100%;
            border-radius: 10px;
            margin-top: 4px;
            transition: background 0.2s ease, transform 0.15s ease;
        }

        .login-card .btn-primary:hover {
            background: #115e59;
            transform: translateY(-1px);
        }

        .login-card .btn-primary:active {
            transform: translateY(0);
        }

        .alert-danger {
            font-size: 13px;
            padding: 10px 14px;
            border-radius: 10px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="avatar">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
            </svg>
        </div>
        <h2>Welcome Back</h2>
        <p class="subtitle">Sign in to your account</p>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert-danger">@ViewBag.Error</div>
        }

        <form method="post" action="@Url.Action("Login", "Home")">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" placeholder="Enter your username" required />
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <div class="password-wrapper">
                    <input type="password" name="password" id="loginPassword" class="form-control" placeholder="Enter your password" required />
                    <button type="button" class="toggle-pw" onclick="togglePassword()" aria-label="Toggle password visibility">
                        <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Sign In</button>
        </form>
    </div>

    <script>
        function togglePassword() {
            var pw = document.getElementById('loginPassword');
            var icon = document.getElementById('eyeIcon');
            if (pw.type === 'password') {
                pw.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
                pw.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        }
    </script>
</body>
</html>
