@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Styles/Home.css")" rel="stylesheet" />
</head>
<body>
    <div class="login-card">
        <div class="avatar">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
            </svg>
        </div>
        <h2>Welcome Back</h2>
        <p class="subtitle">Sign in to your account</p>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert-danger">@ViewBag.Error</div>
        }

        <form method="post" action="@Url.Action("Login", "Home")" id="loginForm">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" placeholder="Enter your username" value="@ViewBag.Username" oninput="clearFieldError(this)" autocomplete="off"/>
                <div class="error-message"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <div class="password-wrapper">
                    <input type="password" name="password" id="loginPassword" class="form-control" placeholder="Enter your password" oninput="clearFieldError(this)" />
                    <button type="button" class="toggle-pw" onclick="togglePassword()" aria-label="Toggle password visibility">
                        <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <div class="error-message"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Database</label>
                <div class="db-select">
                    <input type="hidden" name="connectionName" id="connectionName" value="" />
                    <button type="button" class="db-toggle" id="dbToggle" onclick="toggleDbDropdown(event)">
                        <span id="dbLabel">-- Select Database --</span>
                        <svg class="arrow" id="dbArrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="db-panel" id="dbPanel">
                        @if (ViewBag.Connections != null)
                        {
                            foreach (var conn in ViewBag.Connections)
                            {
                                <div class="db-option" data-value="@conn.Name" onclick="selectDb(this)">
                                    <span>@conn.Name</span>
                                    <svg class="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="error-message"></div>
            </div>
            <button type="submit" class="btn btn-primary" onclick="return validateForm()">Sign In</button>
        </form>
    </div>

    <script src="@Url.Content("~/js/Home.js")"></script>
    <script>
        var selectedDb = '@ViewBag.SelectedConnection';
        if (selectedDb) {
            var opt = document.querySelector('.db-option[data-value="' + selectedDb + '"]');
            if (opt) selectDb(opt);
        }
    </script>
</body>
</html>
