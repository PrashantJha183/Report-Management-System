@* ============================================
   _AuditPanel.cshtml — Shared audit sidebar panel partial
   Include in any grid Index view via:
       @Html.Partial("_AuditPanel")
   Requires: window.auditViewUrl, window.deletedRecordsUrl,
             window.tableName, window.recordIdLabel JS globals.
   ============================================ *@

<div id="auditPanel" style="display:none; flex:1 1 48%; min-width:320px; max-width:600px; margin-left:16px;">
    <div style="background:#fff; border:1px solid #cbd5e1; border-radius:14px; padding:14px; box-shadow:0 14px 28px rgba(15,23,42,0.06);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
            <h4 id="auditPanelTitle" style="margin:0; font-weight:800; font-size:15px; color:#0f172a;">Change History</h4>
            <div>
                <button type="button" class="btn btn-xs btn-default" id="btnDeletedRecords" style="font-weight:700; margin-right:4px;">Deleted Records</button>
                <button type="button" class="btn btn-xs btn-default" id="btnCloseAudit" style="font-weight:700;">Close</button>
            </div>
        </div>
        <iframe id="auditIframe" src="" style="width:100%; height:520px; border:1px solid #e2e8f0; border-radius:8px; background:#fff;"></iframe>
    </div>
</div>
