<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        .navbar-inverse {
            background-color: white !important;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        }

        .navbar-inverse .navbar-nav > li > a {
            color: #334155;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            padding: 14px 18px;
            border-bottom: 3px solid transparent;
            transition: color 0.15s ease, border-bottom 0.15s ease;
            outline: none !important;
        }

        .navbar-inverse .navbar-nav > li > a:hover,
        .navbar-inverse .navbar-nav > li > a:focus,
        .navbar-inverse .navbar-nav > li > a:active {
            color: #0f766e;
            background-color: transparent;
            outline: none !important;
        }

        .navbar-inverse .navbar-nav > .active > a,
        .navbar-inverse .navbar-nav > .active > a:hover,
        .navbar-inverse .navbar-nav > .active > a:focus {
            color: #0f766e;
            background-color: transparent;
            border-bottom-color: #0f766e;
            outline: none !important;
        }

        .navbar-inverse .navbar-nav > .active > a,
        .navbar-inverse .navbar-nav > .active > a:focus {
            color: #0f766e;
            background-color: transparent;
            border-bottom-color: #0f766e;
            outline: none !important;
        }

        .navbar-inverse .navbar-nav > .active > a:hover {
            color: #0f766e;
            background-color: transparent;
            outline: none !important;
        }

        .navbar-brand {
            font-weight: 900;
            font-size: 16px;
            color: #0f172a !important;
            letter-spacing: -0.01em;
            padding: 14px 18px;
        }

        body {
            padding-top: 60px;
        }

        .body-content {
            padding-left: 0;
            padding-right: 0;
        }

        .btn-logout {
            background: none;
            border: 2px solid #fca5a5;
            border-radius: 8px;
            color: #ef4444;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 6px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin: 9px 0;
            line-height: 1.4;
        }

        .btn-logout:hover {
            border-color: #dc2626;
            color: #fff;
            background: #dc2626;
        }

        .navbar-collapse.collapse {
            display: flex !important;
            flex-direction: row;
            align-items: center;
            flex-wrap: nowrap;
        }

        .nav-left-group {
            display: flex !important;
            align-items: center;
            flex: 1;
            flex-wrap: nowrap;
        }

        .nav-right-group {
            display: flex !important;
            align-items: center;
            gap: 18px;
            margin-left: auto;
            flex-wrap: nowrap;
            padding-left: 20px;
        }

        .nav-info-item {
            padding: 0 !important;
            font-size: 13px;
            color: #334155;
            white-space: nowrap;
            display: flex !important;
            align-items: center;
        }

        .nav-icon {
            margin-right: 5px;
            font-size: 14px;
            color: #0f766e;
        }

        .nav-label {
            font-weight: 700;
        }

        .btn-change-pw-nav {
            background: #0f766e !important;
            color: #fff !important;
            font-size: 11px !important;
            font-weight: 800 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.04em !important;
            padding: 6px 14px !important;
            border-radius: 8px !important;
            border: none !important;
            text-decoration: none !important;
            display: inline-block;
            transition: background 0.15s ease;
        }

        .btn-change-pw-nav:hover {
            background: #115e59 !important;
            color: #fff !important;
            text-decoration: none !important;
        }

        .nav-logout-form {
            margin: 0;
            padding: 0;
            display: inline;
        }
    </style>
</head>
<body>
    @if (Session["IsLoggedIn"] != null && (bool)Session["IsLoggedIn"])
    {
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
            </div>
                <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav nav-left-group">
                    <li class="@(ViewContext.RouteData.Values["controller"].ToString() == "Report" ? "active" : "")">
                        @Html.ActionLink("Report Master", "Index", "Report")
                    </li>
                    <li class="@(ViewContext.RouteData.Values["controller"].ToString() == "CompanyConfig" ? "active" : "")">
                        @Html.ActionLink("Company Config", "Index", "CompanyConfig")
                    </li>
                    <li class="@(ViewContext.RouteData.Values["controller"].ToString() == "AlertConfig" ? "active" : "")">
                        @Html.ActionLink("Alert Config", "Index", "AlertConfig")
                    </li>
                    @if (Session["Role"]?.ToString() == "SuperAdmin")
                    {
                        <li class="@(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "")">
                            @Html.ActionLink("User Master", "Index", "User")
                        </li>
                    }
                </ul>
                <ul class="nav navbar-nav nav-right-group">
                    <li class="nav-info-item">
                        <span class="glyphicon glyphicon-user nav-icon"></span>
                        <span class="nav-label">@Session["Username"]</span>
                    </li>
                    <li class="nav-info-item">
                        <span class="glyphicon glyphicon-hdd nav-icon"></span>
                        <span class="nav-label">@Session["CompanyCode"]</span>
                    </li>
                    <li>
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn-change-pw-nav">Change Password</a>
                    </li>
                    <li>
                        <form method="post" action="@Url.Action("Logout", "Home")" class="nav-logout-form">
                            <button type="submit" class="btn-logout">Logout</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    @*<script>
        history.pushState(null, null, location.href);
        window.addEventListener('popstate', function () {
            history.pushState(null, null, location.href);
        });
    </script>*@
    }
    <div class="container-fluid body-content">
        @RenderBody()
        @*<hr />*@
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
