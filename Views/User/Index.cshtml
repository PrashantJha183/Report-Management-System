@model Report.Models.UserGridViewModel

@{
    ViewBag.Title = "User Master";
}

<link rel="stylesheet" href="~/Styles/UserMaster.css" />

<div class="container-fluid" style="margin-top:20px;">
    <div id="toast" style="display:none; position:fixed; top:80px; right:20px; z-index:9999; padding:12px 20px; border-radius:4px; color:#fff; font-weight:bold; box-shadow:0 4px 8px rgba(0,0,0,0.2);"></div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Confirm Delete</h4>
                </div>
                <div class="modal-body">
                    <p id="deleteConfirmMessage">Are you sure you want to deactivate this user?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmOk">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="saveConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Confirm Save</h4>
                </div>
                <div class="modal-body">
                    <p id="saveConfirmMessage">Are you sure you want to save this row?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveConfirmOk">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="successModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Success</h4>
                </div>
                <div class="modal-body">
                    <p id="successModalMessage">Row saved successfully.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <h3><a href="#" onclick="history.back(); return false;" style="text-decoration:none; color:inherit;">&larr;</a> User Master</h3>
    <p class="text-muted">Total Records: @Model.TotalRecords</p>

    <div class="report-toolbar">
        @using (Html.BeginForm("Index", "User", FormMethod.Get, new { @class = "toolbar-form" }))
        {
            <div class="sort-direction-box">
                @Html.DropDownListFor(
                    x => x.SortDirection,
                    new SelectList(
                        new[]
                        {
                            new { Value = "asc", Text = "Ascending" },
                            new { Value = "desc", Text = "Descending" }
                        },
                        "Value",
                        "Text",
                        Model.SortDirection),
                    new { @class = "form-control page-size-select", onchange = "this.form.submit()" })
            </div>

            @Html.HiddenFor(x => x.SortColumn)
            @Html.HiddenFor(x => x.PageSize)
        }

        <div style="display:flex; align-items:center; gap:10px; flex:1;">
            <input type="text" id="searchText" name="SearchText" class="form-control page-size-select" placeholder="Search by Username, Display Name or Role..." value="@Model.SearchText" style="max-width:300px;" autocomplete="off">
        </div>

        <div style="display:flex; gap:8px; margin-left:auto;">
            <button type="button" id="btnAddRow" class="btn modern-btn modern-btn-primary">Add Row</button>
        </div>
    </div>

    <div class="table-panel-container">
        <div class="table-wrapper" id="tableWrapper">
            <div class="modern-table-shell">
        <table class="table modern-report-table">
            <thead>
                <tr>
                    <th>User Id</th>
                    <th>Username</th>
                    <th>Display Name</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th>Created On</th>
                    <th style="width:160px">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No records found.</td>
                    </tr>
                }
                else
                {
                    var rowIndex = 0;
                    foreach (var item in Model.Items)
                    {
                        rowIndex++;
                        var srNo = ((Model.PageNumber - 1) * Model.PageSize) + rowIndex;
                        <tr id="user-@srNo"
                            data-userid="@item.UserId"
                            data-username="@item.Username"
                            data-displayname="@item.DisplayName"
                            data-role="@item.Role"
                            data-isactive="@item.IsActive.ToString().ToLower()"
                            data-createdon="@item.CreatedOn.ToString("yyyy-MM-dd")">
                            <td class="grid-text">@item.UserId</td>
                            <td class="wrap-cell" title="@item.Username">@item.Username</td>
                            <td class="wrap-cell" title="@item.DisplayName">@item.DisplayName</td>
                            <td class="wrap-cell" title="@item.Role">@item.Role</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="label label-success">Active</span>
                                }
                                else
                                {
                                    <span class="label label-danger">Inactive</span>
                                }
                            </td>
                            <td class="grid-text">@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                            <td class="action-cell">
                                <button type="button" class="btn btn-xs btn-primary btn-edit">Edit</button>
                                <button type="button" class="btn btn-xs @(item.IsActive ? "btn-warning" : "btn-success") btn-toggle-active" style="margin-left:3px;">@(item.IsActive ? "Deactivate" : "Activate")</button>
                                @if (Session["Role"]?.ToString() == "SuperAdmin")
                                {
                                    <button type="button" class="btn btn-xs btn-danger btn-delete" style="margin-left:3px;">Delete</button>
                                }
                            </td>
                        </tr>
                        <tr class="edit-row" style="display:none" data-editfor="@srNo">
                            <td colspan="7">
                                <div class="edit-form">
                                    <div class="edit-form-row edit-form-row-user">
                                        <div class="ef-field">
                                            <label>Username<span class="required">*</span></label>
                                            <input type="text" class="form-control" data-column="Username">
                                        </div>
                                        <div class="ef-field">
                                            <label>Display Name<span class="required">*</span></label>
                                            <input type="text" class="form-control" data-column="DisplayName">
                                        </div>
                                        <div class="ef-field">
                                            <label>Password</label>
                                            <div class="pw-toggle-wrapper">
                                                <input type="password" class="form-control" data-column="Password" placeholder="Leave blank to keep current" autocomplete="off">
                                                <button type="button" class="toggle-pw-btn" onclick="togglePw(this)" tabindex="-1" aria-label="Toggle password visibility">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                        <circle cx="12" cy="12" r="3"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="ef-field">
                                            <label>Role<span class="required">*</span></label>
                                            <select class="form-control" data-column="Role">
                                                @{
                                                    var roleService = new Report.Services.RoleService();
                                                    var roles = roleService.GetAllRoleNames();
                                                }
                                                @foreach (var role in roles)
                                                {
                                                    <option value="@role">@role</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="ef-field">
                                            <label>Active</label>
                                            <select class="form-control" data-column="IsActive">
                                                <option value="true">Active</option>
                                                <option value="false">Inactive</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="edit-form-actions">
                                        <button type="button" class="btn btn-save-form">Save</button>
                                        <button type="button" class="btn btn-cancel-form">Cancel</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="bottom-bar">
        <nav>
            <ul class="pagination pagination-sm" style="display:flex; flex-wrap:nowrap; overflow-x:auto; margin:0;">
                <li class="@(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", new {
                            SearchText = Model.SearchText,
                            PageSize = Model.PageSize,
                            SortColumn = Model.SortColumn,
                            SortDirection = Model.SortDirection,
                            PageNumber = Model.PageNumber - 1
                        })">Previous</a>
                    }
                    else
                    {
                        <span>Previous</span>
                    }
                </li>

                @{
                    var windowSize = 5;
                    var halfWindow = windowSize / 2;
                    var startPage = Math.Max(1, Model.PageNumber - halfWindow);
                    var endPage = Math.Min(Model.TotalPages, startPage + windowSize - 1);
                    startPage = Math.Max(1, endPage - windowSize + 1);
                }

                @if (startPage > 1)
                {
                    <li><a href="@Url.Action("Index", new {
                        SearchText = Model.SearchText,
                        PageSize = Model.PageSize,
                        SortColumn = Model.SortColumn,
                        SortDirection = Model.SortDirection,
                        PageNumber = 1
                    })">1</a></li>
                    if (startPage > 2)
                    {
                        <li class="disabled"><a href="#">...</a></li>
                    }
                }

                @for (var page = startPage; page <= endPage; page++)
                {
                    <li class="@(page == Model.PageNumber ? "active" : "")">
                        <a href="@Url.Action("Index", new {
                            SearchText = Model.SearchText,
                            PageSize = Model.PageSize,
                            SortColumn = Model.SortColumn,
                            SortDirection = Model.SortDirection,
                            PageNumber = page
                        })">@page</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="disabled"><a href="#">...</a></li>
                    }
                    <li><a href="@Url.Action("Index", new {
                        SearchText = Model.SearchText,
                        PageSize = Model.PageSize,
                        SortColumn = Model.SortColumn,
                        SortDirection = Model.SortDirection,
                        PageNumber = Model.TotalPages
                    })">@Model.TotalPages</a></li>
                }

                <li class="@(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", new {
                            SearchText = Model.SearchText,
                            PageSize = Model.PageSize,
                            SortColumn = Model.SortColumn,
                            SortDirection = Model.SortDirection,
                            PageNumber = Model.PageNumber + 1
                        })">Next</a>
                    }
                    else
                    {
                        <span>Next</span>
                    }
                </li>
            </ul>
        </nav>
    </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var displayIdCounter = @(ViewBag.NextIdentity ?? 1);
        var saveChangesUrl = '@Url.Action("SaveChanges", "User")';
        var currentUserRole = '@Session["Role"]';
        var deleteUrl = '@Url.Action("Delete", "User")';
        var toggleActiveUrl = '@Url.Action("ToggleActive", "User")';
        var tableName = '@ViewBag.TableName';
    </script>
    <script src="~/js/UserMaster.js"></script>
}
