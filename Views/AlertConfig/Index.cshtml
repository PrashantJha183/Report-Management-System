@model Report.Models.AlertConfigGridViewModel

@{
    ViewBag.Title = "Alert Config";
}

<link rel="stylesheet" href="~/Styles/AlertConfig.css" />

<div class="container-fluid" style="margin-top:20px;">
    <div id="toast" style="display:none; position:fixed; top:80px; right:20px; z-index:9999; padding:12px 20px; border-radius:4px; color:#fff; font-weight:bold; box-shadow:0 4px 8px rgba(0,0,0,0.2);"></div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Confirm Delete</h4>
                </div>
                <div class="modal-body">
                    <p id="deleteConfirmMessage">Are you sure you want to delete this record?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmOk">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteBlockedModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Cannot Delete</h4>
                </div>
                <div class="modal-body">
                    <p>This record has dependent entries. Remove dependencies first.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="saveConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Confirm Save</h4>
                </div>
                <div class="modal-body">
                    <p id="saveConfirmMessage">Are you sure you want to save this row?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveConfirmOk">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="successModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">X</button>
                    <h4 class="modal-title">Success</h4>
                </div>
                <div class="modal-body">
                    <p id="successModalMessage">Row saved successfully.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <h3><a href="#" onclick="history.back(); return false;" style="text-decoration:none; color:inherit;">&larr;</a> Alert Config</h3>
    <p class="text-muted">Total Records: @Model.TotalRecords</p>

    <div class="report-toolbar">
        @using (Html.BeginForm("Index", "AlertConfig", FormMethod.Get, new { @class = "toolbar-form" }))
        {
            <div class="sort-direction-box">
                @Html.DropDownListFor(
                    x => x.SortDirection,
                    new SelectList(
                        new[]
                        {
                            new { Value = "asc", Text = "Ascending" },
                            new { Value = "desc", Text = "Descending" }
                        },
                        "Value",
                        "Text",
                        Model.SortDirection),
                    new { @class = "form-control page-size-select", onchange = "this.form.submit()" })
            </div>

            <input type="hidden" name="SortColumn" value="AlertConfigId" />
            <input type="hidden" name="PageSize" value="5" />
        }

        <div style="display:flex; align-items:center; gap:10px; flex:1;">
            <input type="text" id="searchText" name="SearchText" class="form-control page-size-select" placeholder="Search by AlertName..." value="@Model.SearchText" style="max-width:260px;" autocomplete="off">
        </div>

        <button type="button" id="btnDeletedRecords" class="btn modern-btn" style="margin-left:10px; background:#6b21a8 !important; border-color:#6b21a8 !important; color:#fff !important; font-weight:700;">Deleted Records</button>
        <button type="button" id="btnAddRow" class="btn modern-btn modern-btn-primary" style="margin-left:auto;">Add Row</button>
    </div>

    <div class="table-panel-container">
        <div class="table-wrapper" id="tableWrapper">
            <div class="modern-table-shell">
        <table class="table modern-report-table">
            <thead>
                <tr>
                    <th>Alert Config Id</th>
                    <th style="min-width:120px">Email Subject</th>
                    <th style="min-width:120px">Email Content Header</th>
                    <th style="min-width:120px">Email Content Url</th>
                    <th style="min-width:120px">Email Content Footer</th>
                    <th>Status Id</th>
                    <th>Is Multi Alert</th>
                    <th style="width:280px">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">No records found.</td>
                    </tr>
                }
                else
                {
                    var rowIndex = 0;
                    foreach (var item in Model.Items)
                    {
                        rowIndex++;
                        var srNo = ((Model.PageNumber - 1) * Model.PageSize) + rowIndex;
                        <tr id="alertconfig-@srNo"
                            data-table="@ViewBag.TableName"
                            data-alertconfigid="@item.AlertConfigId"
                            data-alertname="@item.AlertName"
                            data-reportid="@item.ReportId"
                            data-isemailnotify="@(item.IsEmailNotify ? "1" : "0")"
                            data-emailsubject="@item.EmailSubject"
                            data-emailcontentheader="@item.EmailContentHeader"
                            data-emailcontenturl="@item.EmailContentUrl"
                            data-attachmentfiletypeid="@item.AttachmentFileTypeId"
                            data-emailattachmenturl="@item.EmailAttachmentUrl"
                            data-statusid="@item.StatusId"
                            data-alerttypeid="@item.AlertTypeId"
                            data-ismultialert="@(item.IsMultiAlert ? "1" : "0")"
                            data-multialertquery="@item.MultiAlertQuery"
                            data-emailcontentfooter="@item.EmailContentFooter"
                            data-createdby="@item.CreatedBy"
                            data-createdon="@item.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")"
                            data-updatedby="@(item.UpdatedBy.HasValue ? item.UpdatedBy.Value.ToString() : "")"
                            data-updatedon="@(item.UpdatedOn.HasValue ? item.UpdatedOn.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")">
                            <td class="grid-text">@item.AlertConfigId</td>
                            <td class="wrap-cell" title="@item.EmailSubject">@item.EmailSubject</td>
                            <td class="wrap-cell" title="@item.EmailContentHeader">@item.EmailContentHeader</td>
                            <td class="wrap-cell" title="@item.EmailContentUrl">@item.EmailContentUrl</td>
                            <td class="wrap-cell" title="@item.EmailContentFooter">@item.EmailContentFooter</td>
                            <td>@item.StatusId</td>
                            <td>@(item.IsMultiAlert ? "1" : "0")</td>
                            <td class="action-cell">
<button type="button" class="btn btn-xs btn-primary"
        onclick="window.location='@Url.Action("Index", "AlertSchedule", new { FilterAlertConfigId = item.AlertConfigId })'"
        style="margin-right:3px; background:#0891b2 !important; border-color:#06b6d4 !important; color:#fff !important; font-weight:800; border-radius:6px !important; padding:6px 8px; font-size:11px;">
    Schedule
</button>

<button type="button" class="btn btn-xs btn-primary"
        onclick="window.location='@Url.Action("Index", "AlertConfigAttachment", new { FilterAlertConfigId = item.AlertConfigId })'"
        style="margin-right:3px; background:#d97706 !important; border-color:#d97706 !important; color:#fff !important; font-weight:800; border-radius:6px !important; padding:6px 8px; font-size:11px;">
    Attachment
</button>

<button type="button" class="btn btn-xs btn-primary btn-edit">Edit</button>

                                <button type="button" class="btn btn-xs btn-info btn-view-alert-audit" data-table="@ViewBag.AuditTableName" data-id="@item.AlertConfigId" data-alertname="@item.AlertName" style="margin-left:3px;">View</button>
                            </td>
                        </tr>
                        <tr class="edit-row" style="display:none" data-editfor="@srNo">
                            <td colspan="8">
                                <div class="edit-form">
                                    <div class="edit-form-row">
                                        @* ZONE 2: 2 rows x 3 columns = 6 compact fields *@
                                        <div class="ef-field">
                                            <label>Report Id<span class="required">*</span></label>
                                            <input type="number" class="form-control no-arrows" data-column="ReportId">
                                        </div>
                                        <div class="ef-field">
                                            <label>Is Email Notify<span class="required">*</span></label>
                                            <select class="form-control" data-column="IsEmailNotify">
                                                <option value="1">1</option>
                                                <option value="0" selected>0</option>
                                            </select>
                                        </div>
                                        <div class="ef-field">
                                            <label>Attachment File Type Id</label>
                                            <input type="number" class="form-control no-arrows" data-column="AttachmentFileTypeId">
                                        </div>
                                        <div class="ef-field">
                                            <label>Alert Type Id</label>
                                            <input type="number" class="form-control no-arrows" data-column="AlertTypeId">
                                        </div>
                                        <div class="ef-field">
                                            <label>Status Id<span class="required">*</span></label>
                                            <select class="form-control" data-column="StatusId">
                                                <option value="30">30</option>
                                                <option value="200">200</option>
                                            </select>
                                        </div>
                                        <div class="ef-field">
                                            <label>Is Multi Alert<span class="required">*</span></label>
                                            <select class="form-control" data-column="IsMultiAlert">
                                                <option value="1">1</option>
                                                <option value="0" selected>0</option>
                                            </select>
                                        </div>

                                        @* ZONE 3: Full-width textareas *@
                                        <div class="ef-field full">
                                            <label>Alert Name<span class="required">*</span></label>
                                            <textarea class="form-control" data-column="AlertName" rows="2"></textarea>
                                        </div>
                                        <div class="ef-field full">
                                            <label>Email Subject<span class="required">*</span></label>
                                            <textarea class="form-control" data-column="EmailSubject" rows="3"></textarea>
                                        </div>
                                        <div class="ef-field full">
                                            <label>Email Content Header<span class="required">*</span></label>
                                            <textarea class="form-control" data-column="EmailContentHeader" rows="3"></textarea>
                                        </div>
                                        <div class="ef-field full">
                                            <label>Email Content Url<span class="required">*</span></label>
                                            <textarea class="form-control" data-column="EmailContentUrl" rows="2"></textarea>
                                        </div>
                                        <div class="ef-field full">
                                            <label>Email Attachment Url</label>
                                            <textarea class="form-control" data-column="EmailAttachmentUrl" rows="2"></textarea>
                                        </div>
                                        <div class="ef-field full">
                                            <label>Multi Alert Query</label>
                                            <textarea class="form-control" data-column="MultiAlertQuery" rows="3"></textarea>
                                        </div>
                                        <div class="ef-field full">
                                            <label>Email Content Footer<span class="required">*</span></label>
                                            <textarea class="form-control" data-column="EmailContentFooter" rows="3"></textarea>
                                        </div>

                                        @* Hidden fields for server-managed audit columns *@
                                        <input type="hidden" data-column="CreatedBy">
                                        <input type="hidden" data-column="UpdatedBy">
                                        <input type="hidden" data-column="CreatedOn">
                                        <input type="hidden" data-column="UpdatedOn">
                                    </div>
                                    <div class="edit-form-actions">
                                        <button type="button" class="btn btn-save-form">Save</button>
                                        <button type="button" class="btn btn-cancel-form">Cancel</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="bottom-bar">
        <nav>
            <ul class="pagination pagination-sm" style="display:flex; flex-wrap:nowrap; overflow-x:auto; margin:0;">
                <li class="@(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", new {
                            SearchText = Model.SearchText,
                            PageSize = Model.PageSize,
                            SortColumn = Model.SortColumn,
                            SortDirection = Model.SortDirection,
                            PageNumber = Model.PageNumber - 1
                        })">Previous</a>
                    }
                    else
                    {
                        <span>Previous</span>
                    }
                </li>

                @{
                    var windowSize = 5;
                    var halfWindow = windowSize / 2;
                    var startPage = Math.Max(1, Model.PageNumber - halfWindow);
                    var endPage = Math.Min(Model.TotalPages, startPage + windowSize - 1);
                    startPage = Math.Max(1, endPage - windowSize + 1);
                }

                @if (startPage > 1)
                {
                    <li><a href="@Url.Action("Index", new {
                        SearchText = Model.SearchText,
                        PageSize = Model.PageSize,
                        SortColumn = Model.SortColumn,
                        SortDirection = Model.SortDirection,
                        PageNumber = 1
                    })">1</a></li>
                    if (startPage > 2)
                    {
                        <li class="disabled"><a href="#">...</a></li>
                    }
                }

                @for (var page = startPage; page <= endPage; page++)
                {
                    <li class="@(page == Model.PageNumber ? "active" : "")">
                        <a href="@Url.Action("Index", new {
                            SearchText = Model.SearchText,
                            PageSize = Model.PageSize,
                            SortColumn = Model.SortColumn,
                            SortDirection = Model.SortDirection,
                            PageNumber = page
                        })">@page</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="disabled"><a href="#">...</a></li>
                    }
                    <li><a href="@Url.Action("Index", new {
                        SearchText = Model.SearchText,
                        PageSize = Model.PageSize,
                        SortColumn = Model.SortColumn,
                        SortDirection = Model.SortDirection,
                        PageNumber = Model.TotalPages
                    })">@Model.TotalPages</a></li>
                }

                <li class="@(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", new {
                            SearchText = Model.SearchText,
                            PageSize = Model.PageSize,
                            SortColumn = Model.SortColumn,
                            SortDirection = Model.SortDirection,
                            PageNumber = Model.PageNumber + 1
                        })">Next</a>
                    }
                    else
                    {
                        <span>Next</span>
                    }
                </li>
            </ul>
        </nav>
    </div>
        </div>
        <div id="auditPanel" style="display:none; flex:0 0 calc(50% - 15px); min-width:280px; border:1px solid #ddd; border-radius:6px; background:#fff; margin-left:15px; align-self:stretch;">
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; background:#f5f5f5; border-bottom:1px solid #ddd;">
                <strong style="font-size:14px; color:#1a1a2e;" id="auditPanelTitle">Change History</strong>
                <button type="button" id="btnCloseAudit" style="border:none; background:none; font-size:22px; cursor:pointer; line-height:1; color:#666; padding:0 4px;">&times;</button>
            </div>
            <iframe id="auditIframe" style="width:100%; height:calc(100vh - 250px); border:none; display:block;"></iframe>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var displayIdCounter = @(ViewBag.NextIdentity ?? 1);
        var saveChangesUrl = '@Url.Action("SaveChanges", "AlertConfig")';
        var scheduleUrl = '@Url.Action("Index", "AlertSchedule")';
        var attachmentUrl = '@Url.Action("Index", "AlertConfigAttachment")';
        var deleteUrl = '@Url.Action("Delete", "AlertConfig")';
        var auditUrl = '@Url.Action("GetAuditLogs", "AuditTrail")';
        var auditViewUrl = '@Url.Action("AuditLogs", "AuditTrail")';
        var deletedRecordsUrl = '@Url.Action("DeletedRecords", "AuditTrail")';
        var tableName = '@ViewBag.TableName';
        var auditTableName = '@ViewBag.AuditTableName';
        var recordIdLabel = '@ViewBag.RecordIdLabel';
        var colspan = @ViewBag.Colspan;
    </script>
    <script src="~/js/AlertConfig.js"></script>
}