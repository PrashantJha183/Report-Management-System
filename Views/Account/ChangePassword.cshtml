@model Report.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<head>
    <link href="@Url.Content("~/Styles/Account.css")" rel="stylesheet" />
</head>

<div class="change-pw-page">
    <div class="change-pw-card">
        <div class="change-pw-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/>
            </svg>
        </div>
        <h2>Change Password</h2>
        <p class="subtitle">Update your account password</p>

        @if (!string.IsNullOrEmpty(ViewBag.Message as string))
        {
            <div class="alert-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                @ViewBag.Message
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "", style = "margin:0;padding:0;list-style:none;" })
            </div>
        }

        <form method="post" action="@Url.Action("ChangePassword", "Account")" id="changePwForm">
            @Html.AntiForgeryToken()

            <div class="mb-3" style="margin-bottom:16px;">
                @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label" })
                <div class="input-group-icon">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", placeholder = "Enter current password", id = "currentPw", autocomplete = "off" })
                    <button type="button" class="toggle-pw-btn" onclick="togglePw('currentPw', this)" tabindex="-1" aria-label="Toggle password visibility">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "field-validation-error" })
            </div>

            <div class="mb-3" style="margin-bottom:16px;">
                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                <div class="input-group-icon">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password", id = "newPw", autocomplete = "off", oninput = "updateStrength()" })
                    <button type="button" class="toggle-pw-btn" onclick="togglePw('newPw', this)" tabindex="-1" aria-label="Toggle password visibility">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <div class="pw-strength" id="pwStrength" style="display:none;">
                    <div class="pw-strength-bar">
                        <div class="pw-strength-bar-inner" id="pwStrengthBar"></div>
                    </div>
                    <div class="pw-strength-text" id="pwStrengthText"></div>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-validation-error" })
            </div>

            <div class="mb-4" style="margin-bottom:24px;">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                <div class="input-group-icon">
                    <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password", id = "confirmPw", autocomplete = "off", oninput = "checkMatch()" })
                    <button type="button" class="toggle-pw-btn" onclick="togglePw('confirmPw', this)" tabindex="-1" aria-label="Toggle password visibility">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <div id="matchStatus" style="font-size:12px;font-weight:600;margin-top:4px;"></div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
            </div>

            <button type="submit" class="btn btn-primary" id="submitBtn">Update Password</button>
        </form>

        <div class="change-pw-back">
            @Html.ActionLink("Back to Report Master", "Index", "Report")
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/js/Account.js")"></script>
}
